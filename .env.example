# =============================================
# GravMix — API Keys Template
# Скопировать в .env и заполнить реальными ключами
# ЭТОТ ФАЙЛ МОЖНО КОММИТИТЬ. .env — НЕЛЬЗЯ.
# =============================================

# Wildberries
WB_API_KEY=ваш_ключ_wildberries_content_api

# Ozon (Кабинет №2)
OZON_CLIENT_ID=ваш_client_id
OZON_API_KEY=ваш_api_key_ozon

# Яндекс Маркет
YM_OAUTH_TOKEN=ваш_oauth_token
YM_CAMPAIGN_ID=ваш_id_кампании
YM_BUSINESS_ID=ваш_business_id
